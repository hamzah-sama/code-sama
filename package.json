{
  "name": "code-sama",
  "version": "1.0.0",
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "build:cli": "bun run --filter @code-sama/cli build",
    "link:cli": "cd packages/cli && bun link"
  },
  "workspaces": ["packages/*"],
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}